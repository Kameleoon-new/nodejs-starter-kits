<%# Cosmetic only: nothing here is part of the Kameleoon integration. %>
<style>
  body { font: 16px/1.5 system-ui, sans-serif; color: #1e293b; background: #f8fafc; margin: 0; padding: 32px 16px; }
  main { max-width: 720px; margin: 0 auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 32px; }
  nav { display: flex; gap: 8px; margin-bottom: 24px; }
  nav a { padding: 6px 12px; border-radius: 8px; text-decoration: none; color: #475569; background: #f1f5f9; }
  nav a.current { color: #fff; background: #4f46e5; }
  h1 { font-size: 24px; margin: 0 0 8px; }
  h2 { font-size: 16px; margin: 28px 0 8px; }
  p { margin: 0 0 12px; color: #475569; }
  ol { margin: 0; padding-left: 20px; color: #475569; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px 12px 8px 0; border-top: 1px solid #e2e8f0; vertical-align: top; }
  th { color: #64748b; font-weight: 500; }
  code, pre { font: 13px/1.5 ui-monospace, Menlo, monospace; color: #4338ca; }
  button { font: inherit; padding: 6px 14px; border: 1px solid #cbd5e1; border-radius: 8px; background: #fff; cursor: pointer; }
  pre { margin: 0; padding: 12px; background: #f1f5f9; border-radius: 8px; white-space: pre-wrap; word-break: break-all; }
</style>
