<%#
  Kameleoon engine.js for a hybrid page: visitor synchronization, browser half.
  Include it as high as possible in <head>.

  Locals:
    siteCode            site code of the Kameleoon project
    visitorCode         visitor code returned by the SDK for this request
    consent             "granted", "denied" or "unknown", as given to the SDK
    engineTrackingCode  optional, result of kameleoonClient.getEngineTrackingCode()

  Order matters: visitor code, consent, tracking code, and engine.js is loaded last.
%>
<script>
  // Commands pushed here wait until engine.js is loaded
  window.kameleoonQueue = window.kameleoonQueue || [];

  // 1. Visitor code: give engine.js the visitor code the SDK used for this request,
  //    so the server and the browser identify the same visitor. The cookie alone is
  //    not enough: when the project requires consent, it is not written until the
  //    visitor accepts.
  //    "IMMEDIATE" runs the command before engine.js does anything else.
  <%# JSON.stringify writes the value as a safe JavaScript string. Do not use the HTML-escaping
      EJS tag here: entities are not decoded inside a script and would change the visitor code. %>
  window.kameleoonQueue.push({
    level: "IMMEDIATE",
    command: function () {
      Kameleoon.API.Visitor.setVisitorCode(<%- JSON.stringify(visitorCode).replace(/</g, "\\u003c") %>);
    }
  });

  // 2. Legal consent: give engine.js the same choice the SDK received for this request.
  //    While the choice is unknown nothing is sent, as on the server.
  <% if (consent === "granted") { %>
  window.kameleoonQueue.push(function () {
    Kameleoon.API.Core.enableLegalConsent();
  });
  <% } else if (consent === "denied") { %>
  window.kameleoonQueue.push(function () {
    Kameleoon.API.Core.disableLegalConsent();
  });
  <% } %>
</script>

<% if (locals.engineTrackingCode) { %>
<script>
  // 3. Engine tracking code generated by the SDK (engine-side tracking only): tells
  //    engine.js which variations the SDK assigned, and engine.js reports the exposure.
  <%- engineTrackingCode %>
</script>
<% } %>

<script src="https://<%= siteCode %>.kameleoon.io/engine.js" async fetchpriority="high"></script>
