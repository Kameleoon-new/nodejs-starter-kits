{
  "name": "hybrid-starter-kit",
  "version": "1.0.0",
  "description": "Kameleoon hybrid starter kit: Node.js SDK with engine.js, server-side and engine-side tracking",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch ./src/app.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp -R src/views dist/",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@kameleoon/nodejs-event-source": "^1.3.0",
    "@kameleoon/nodejs-requester": "^1.3.0",
    "@kameleoon/nodejs-sdk": "^5.30.1",
    "@kameleoon/nodejs-visitor-code-manager": "^1.2.1",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.10",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
