# --- Required -----------------------------------------------------------------

# Site code of the Kameleoon project (also used in the engine.js URL)
KAMELEOON_SITECODE=xxxxxxxxxx

# API credentials of the Kameleoon account
KAMELEOON_CLIENT_ID=xxxxxx
KAMELEOON_CLIENT_SECRET=xxxxxx

# Feature flag evaluated on the server-side tracking page (/server-tracking)
KAMELEOON_FEATURE_KEY=xxxxxx

# --- Optional -----------------------------------------------------------------

# production (default), staging, development, or a custom environment key
# KAMELEOON_ENVIRONMENT=development

# Domain of the visitor code cookie, e.g. .example.com. Set it when the site uses
# several subdomains; leave it out on localhost.
# KAMELEOON_COOKIE_DOMAIN=.example.com

# PORT=3000
